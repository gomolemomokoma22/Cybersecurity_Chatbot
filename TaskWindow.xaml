<Window x:Class="CyberSecurityChatbot.TaskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Task Manager" Height="400" Width="600"
        Background="#1E1E1E"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Input Fields -->
        <StackPanel Orientation="Vertical" Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Task Title:" Foreground="White"/>
            <TextBox x:Name="TitleInput" Margin="0,5,0,10"/>

            <TextBlock Text="Description:" Foreground="White"/>
            <TextBox x:Name="DescriptionInput" Margin="0,5,0,10"/>

            <TextBlock Text="Reminder Date:" Foreground="White"/>
            <DatePicker x:Name="ReminderDate" Margin="0,5,0,10"/>
        </StackPanel>

        <!-- Task List -->
        <ListBox x:Name="TaskList" Grid.Row="1" Background="#2D2D2D" Foreground="White" BorderBrush="#444" Margin="0,10"/>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="AddTask" Content="Add Task" Click="AddTask_Click" Margin="5" Padding="10,5"/>
            <Button x:Name="ClearTasks" Content="Clear Tasks" Click="ClearTasks_Click" Margin="5" Padding="10,5"/>
        </StackPanel>
    </Grid>
</Window>
