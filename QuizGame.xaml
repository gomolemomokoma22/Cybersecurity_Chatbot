<Window x:Class="CyberSecurityChatbot.QuizGame"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cybersecurity Quiz Game"
        Height="500" Width="700"
        WindowStartupLocation="CenterScreen"
        Background="DarkGreen">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Quiz Header -->
        <TextBlock x:Name="QuestionText"
                   Text="Question will appear here"
                   FontSize="20"
                   FontWeight="Bold"
                   Foreground="Blue"
                   TextWrapping="Wrap"
                   Margin="10"/>

        <!-- Answer Options -->
        <StackPanel Grid.Row="1" Margin="10">
            <RadioButton x:Name="OptionA" GroupName="Answers" Foreground="White" FontSize="16" Margin="0,5"/>
            <RadioButton x:Name="OptionB" GroupName="Answers" Foreground="White" FontSize="16" Margin="0,5"/>
            <RadioButton x:Name="OptionC" GroupName="Answers" Foreground="White" FontSize="16" Margin="0,5"/>
            <RadioButton x:Name="OptionD" GroupName="Answers" Foreground="White" FontSize="16" Margin="0,5"/>
        </StackPanel>

        <!-- Navigation Buttons and Score -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
            <Button Content="Next"
                    Click="Next_Click"
                    Background="LimeGreen"
                    Foreground="White"
                    FontWeight="Bold"
                    Width="100"
                    Margin="10"/>
            <Button Content="Exit"
                    Click="Exit_Click"
                    Background="Red"
                    Foreground="White"
                    FontWeight="Bold"
                    Width="100"
                    Margin="10"/>
        </StackPanel>
    </Grid>
</Window>
