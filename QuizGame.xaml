<Window x:Class="CyberSecurityChatbot.QuizGame"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cybersecurity Quiz Game" Height="550" Width="700"
        Background="#1E1E1E"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Quiz Header -->
        <TextBlock x:Name="QuestionText"
                   FontSize="20"
                   FontWeight="Bold"
                   Foreground="LightSkyBlue"
                   TextWrapping="Wrap"
                   Margin="10"/>

        <!-- Answer Options -->
        <StackPanel Grid.Row="1" Margin="10">
            <RadioButton x:Name="OptionA" GroupName="Answers" Foreground="White" FontSize="16" Margin="0,5"/>
            <RadioButton x:Name="OptionB" GroupName="Answers" Foreground="White" FontSize="16" Margin="0,5"/>
            <RadioButton x:Name="OptionC" GroupName="Answers" Foreground="White" FontSize="16" Margin="0,5"/>
            <RadioButton x:Name="OptionD" GroupName="Answers" Foreground="White" FontSize="16" Margin="0,5"/>
        </StackPanel>

        <!-- Navigation Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
            <Button Content="Next"
                    Click="Next_Click"
                    Background="#007ACC"
                    Foreground="White"
                    FontWeight="Bold"
                    Width="120"
                    Margin="10"/>
            <Button Content="Exit"
                    Click="Exit_Click"
                    Background="#444"
                    Foreground="White"
                    FontWeight="Bold"
                    Width="120"
                    Margin="10"/>
        </StackPanel>
    </Grid>
</Window>
