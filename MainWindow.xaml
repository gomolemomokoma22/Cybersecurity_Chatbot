<Window x:Class="CyberSecurityChatbot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CyberSecurity Chatbot" Height="500" Width="700"
        Background="#1E1E1E" WindowStartupLocation="CenterScreen">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20" Spacing="10">

            <!-- Cybersecurity Logo -->
            <Image Source="Resources/cyber-security.logo.jfif"
                   Width="120" Height="120"
                   Margin="0,0,0,10"
                   HorizontalAlignment="Center">
                <Image.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="2"/>
                </Image.Effect>
            </Image>

            <!-- App Title -->
            <TextBlock Text="CyberSecurity Chatbot"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20"/>

            <!-- Navigation Buttons -->
            <Button Content=" Start Chat"
                    Click="OpenChat_Click"
                    Width="200" Height="40"
                    Background="#007ACC" Foreground="White"
                    FontWeight="Bold" Margin="0,5"/>

            <Button Content="Task Manager"
                    Click="OpenTaskAssistant_Click"
                    Width="200" Height="40"
                    Background="#007ACC" Foreground="White"
                    FontWeight="Bold" Margin="0,5"/>

            <Button Content=" Quiz Game"
                    Click="OpenQuiz_Click"
                    Width="200" Height="40"
                    Background="#007ACC" Foreground="White"
                    FontWeight="Bold" Margin="0,5"/>

            <Button Content=" Activity Log"
                    Click="OpenLog_Click"
                    Width="200" Height="40"
                    Background="#007ACC" Foreground="White"
                    FontWeight="Bold" Margin="0,5"/>

            <Button Content=" Exit"
                    Click="Exit_Click"
                    Width="200" Height="40"
                    Background="DarkRed" Foreground="White"
                    FontWeight="Bold" Margin="0,10"/>
        </StackPanel>
    </Grid>
</Window>

