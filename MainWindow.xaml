<Window x:Class="CyberSecurityChatbot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cybersecurity Chatbot Hub"
        Height="450" Width="800"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E">

    <Window.Resources>
        <!-- Reusable style for sidebar buttons -->
        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="Background" Value="#007ACC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>

        <!-- Sidebar -->
        <Grid Width="160" Background="#2D2D30" HorizontalAlignment="Left">
            <StackPanel Margin="10">
                <TextBlock Text="NAVIGATION MENU"
                           FontSize="15"
                           FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,15"/>

                <Button Content="Quiz Game" Click="OpenQuiz_Click"
                        Style="{StaticResource MenuButtonStyle}"/>

                <Button Content="Chats" Click="OpenChatbotInteraction_Click"
                        Style="{StaticResource MenuButtonStyle}"/>

                <Button Content="Activity Log" Click="OpenActivityLog_Click"
                        Style="{StaticResource MenuButtonStyle}"/>

                <Button Content="Task Manager" Click="OpenTaskAssistant_Click"
                        Style="{StaticResource MenuButtonStyle}"/>

                <Button Content="Exit" Click="Exit_Click"
                        Background="Red"
                        Foreground="White"
                        FontWeight="Bold"
                        BorderBrush="Transparent"
                        Margin="0,20,0,0"
                        Padding="10,5"/>
            </StackPanel>
        </Grid>

        <!-- Main Content Area -->
        <Grid Margin="160,0,0,0" Background="#1E1E1E" Name="MainContentArea">
            <TextBlock Text="Welcome to the Cybersecurity Hub"
                       Foreground="White"
                       FontSize="24"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Grid>

    </Grid>
</Window>
