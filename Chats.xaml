<Window x:Class="CyberSecurityChatbot.Chats"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cybersecurity Chatbot" Height="500" Width="650"
        Background="#1E1E1E" WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Chat Display -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Grid.Row="0">
            <StackPanel x:Name="ChatPanel" Margin="5"/>
        </ScrollViewer>

        <!-- Input and Send -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
            <TextBox x:Name="UserInput" Width="480" Height="30" Margin="0,0,10,0"/>
            <Button Content="Send" Width="100" Background="#007ACC" Foreground="White"
                    FontWeight="Bold" Click="Send_Click"/>
        </StackPanel>

        <!-- Back Button -->
        <Button Grid.Row="2" Content="Back to Home"
                Click="BackToMain_Click"
                Margin="0,10,0,0"
                Width="150"
                Height="30"
                Background="DarkGray"
                Foreground="White"
                HorizontalAlignment="Center"/>
    </Grid>
</Window>
